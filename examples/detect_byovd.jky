case "INC-BYOVD-001" description "Detection of vulnerable kernel drivers cataloged in LOLDrivers";

capabilities {
    grant driver.read;
    grant evidence.export;
}

import std.forensics.windows as win;
import std.detect.byovd as byovd;

// Enumerate loaded kernel drivers and filter for un-whql or cataloged vulnerable hashes
query vulnerable_drivers = host.drivers()
    | filter(d => d.is_known_vulnerable == true or d.is_whql == false);

detect byovd_driver on vulnerable_drivers {
    technique: "T1068 / T1543.003 - Bring Your Own Vulnerable Driver (BYOVD)",
    severity: CRITICAL,
    condition: vulnerable_drivers.count() > 0,
    rationale: "Loaded driver matches known vulnerable driver exploited for privilege escalation"
}

evidence.export(vulnerable_drivers, format=CASE_JSON_LD, destination="evidence://vault/drivers");
